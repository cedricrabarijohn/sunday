# Copy to .env and fill in real values. NEVER commit a real .env.
# Generate strong secrets with: openssl rand -base64 48

NAMESPACE=sunday

# development | staging | production
APP_ENV=development

# Database
DB_HOST=db
DB_PORT=3306
DB_USER=sunday
DB_PASSWORD=__change_me__
DB_ROOT_PASSWORD=__change_me__
DB_NAME=sunday_db
# Max DB connections in the pool (raise under load). Defaults to 10.
DB_POOL_SIZE=10

# Auth — REQUIRED. In production the app refuses to boot if this is the
# placeholder or shorter than 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-64-char-string-in-production

# Public base URL (used to build links in emails). Must be the real https URL
# in production, e.g. https://app.yourdomain.com
APP_URL=http://localhost:3000

# Mail — dev uses the Mailpit container. In prod, point at your real SMTP and
# set SMTP_USER/PASSWORD + SMTP_SECURE=true (port 465). Configure SPF/DKIM/DMARC
# on the sending domain or mail lands in spam.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Sunday <no-reply@sunday.local>

# Attachment storage. Default `local` writes files to public/uploads on disk —
# no extra services, ideal for self-hosting. Switch to `s3` only if you want an
# S3-compatible store (MinIO / S3 / R2 / Spaces) for scale or multi-instance.
STORAGE_DRIVER=local

# --- S3 settings: only needed when STORAGE_DRIVER=s3 ---
# Start the bundled MinIO with: COMPOSE_PROFILES=s3 make start  (or `make start-s3`)
# S3_BUCKET=sunday-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=http://minio:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=__change_me__
# S3_SECRET_ACCESS_KEY=__change_me__
# S3_PUBLIC_BASE_URL=http://localhost:9000
