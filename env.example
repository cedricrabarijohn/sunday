NAMESPACE=sunday
APP_ENV=development / staging / production


# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=sunday
DB_PASSWORD=password
DB_ROOT_PASSWORD=password
DB_NAME=sunday_db

JWT_SECRET=change-me-to-a-random-64-char-string-in-production

# ---------- Storage ----------
# STORAGE_DRIVER selects the backend for card image attachments.
#   local  -> writes to /public/uploads (dev only; not durable in prod)
#   s3     -> any S3-compatible service (AWS S3, MinIO, R2, Spaces)
STORAGE_DRIVER=local

# The bucket name. Auto-created in MinIO via the minio-init service.
S3_BUCKET=sunday-uploads

# Used when signing requests. Any string works for MinIO.
S3_REGION=us-east-1

# Internal endpoint the *server* uses to upload.
# - Inside docker compose: http://minio:9000
# - Talking to real AWS S3: leave unset
S3_ENDPOINT=http://minio:9000

# MinIO requires path-style. AWS S3 prefers virtual-hosted (set to false).
S3_FORCE_PATH_STYLE=true

# Credentials. Match the MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in compose.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Browser-facing base URL. We append /<bucket>/<key>. Use a CDN here in prod.
# - Dev with MinIO mapped to host port 9000:  http://localhost:9000
# - AWS S3 public bucket:                     https://s3.<region>.amazonaws.com
# - Cloudflare R2 with custom domain:         https://files.example.com
S3_PUBLIC_BASE_URL=http://localhost:9000
